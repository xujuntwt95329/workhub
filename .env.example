# Local development works without this file. These values configure server deployment.
DOMAIN=workhub.example.com
PUBLIC_URL=https://workhub.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Run: node scripts/generate-secrets.mjs
KEY_ENCRYPTION_KEY=replace-with-64-hex-characters
SETUP_TOKEN=replace-with-a-long-random-token
# Optional, exact comma-separated origins for a private LLM service.
# LLM_ALLOWED_ORIGINS=http://ollama:11434
